# StudyPilot AI - backend environment
#
# Copy to `.env` for local development. In production set these on the host
# (Render dashboard / render.yaml) instead — never commit a real .env.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development          # `production` refuses the placeholder SECRET_KEY
DEBUG=true

# --- Database ----------------------------------------------------------------
# SQLite for local work. In production paste Render's Internal Database URL
# as-is; the `postgres://` scheme is rewritten automatically.
DATABASE_URL=sqlite:///./studypilot.db
# DATABASE_URL=postgresql://user:password@host:5432/studypilot

# --- Security ----------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_EXPIRE_MINUTES=43200

# --- Password reset codes ----------------------------------------------------
RESET_CODE_EXPIRE_MINUTES=15
RESET_CODE_MAX_ATTEMPTS=5
RESET_CODE_RESEND_SECONDS=60

# --- Scheduled tasks ---------------------------------------------------------
# Shared secret for POST /api/v1/tasks/daily-reminders, the endpoint an external
# scheduler calls to send the daily plan emails. Unset means those endpoints
# refuse every request, which is the safe default: an open trigger would let
# anyone make the app email its whole user base.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# TASK_SECRET=

# --- Outbound email ----------------------------------------------------------
# REQUIRED for password reset to work. Leave this unset locally and the code is
# written to the server log instead of emailed, which is enough to walk through
# the flow without a mail server. In production, unset logs an error at
# start-up, because a student who forgets their password then has no way back
# into their account.
#
# EMAIL_PROVIDER picks the transport, and the choice matters on Render:
#
#   brevo    Brevo's HTTPS API. **Use this on Render's free tier.** Free
#            instances block outbound SMTP ports 25/465/587, so smtp sends time
#            out there no matter how correct the credentials are; this goes over
#            443. Brevo also verifies a single sender address, so no domain is
#            needed. Key from https://app.brevo.com -> SMTP & API -> API keys.
#     EMAIL_PROVIDER=brevo
#     EMAIL_API_KEY=<xkeysib-... key>
#     EMAIL_FROM=you@gmail.com     # verify this address in Brevo first
#
#   resend   Resend's HTTPS API. Also unblocked, but needs a verified domain to
#            send to arbitrary recipients.
#     EMAIL_PROVIDER=resend
#     EMAIL_API_KEY=<re_... key>
#     EMAIL_FROM=noreply@yourdomain.com
#
#   smtp     Classic SMTP. Fine locally, and on a paid Render instance.
#            Gmail needs 2FA and an App Password, not the account password:
#            https://myaccount.google.com/apppasswords
#     EMAIL_PROVIDER=smtp
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USERNAME=you@gmail.com
#     SMTP_PASSWORD=<16 character app password, spaces removed>
#     EMAIL_FROM=you@gmail.com
#
EMAIL_PROVIDER=smtp
# EMAIL_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true            # STARTTLS on 587
# SMTP_USE_SSL=false           # set true, and port 465, for implicit TLS
# EMAIL_FROM=                  # defaults to SMTP_USERNAME
EMAIL_FROM_NAME=StudyPilot AI

# --- CORS --------------------------------------------------------------------
# Comma separated. *.vercel.app is already allowed by a regex in main.py, so
# FRONTEND_URL only matters for a custom domain.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FRONTEND_URL=https://your-app.vercel.app

# --- Uploads -----------------------------------------------------------------
# Point at a mounted disk in production. A container's own filesystem is wiped
# on every deploy, taking uploaded syllabi and past papers with it.
UPLOAD_DIR=uploads
