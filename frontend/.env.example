# StudyPilot AI - frontend environment
#
# Vite only exposes variables prefixed with VITE_, and inlines them at BUILD
# time — changing one on the host requires a redeploy, not a restart.

# Base URL of the API, with no trailing slash and no /api/v1 suffix
# (the client appends it). Leave empty for local development: the Vite dev
# server proxies /api and /uploads to http://127.0.0.1:8000, which keeps
# everything same-origin.
#
# In production set this in the Vercel project to your Render URL:
#   VITE_API_URL=https://studypilot-api.onrender.com
VITE_API_URL=
