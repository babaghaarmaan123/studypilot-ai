# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- Local database ----------------------------------------------------------
# The development SQLite file holds real accounts and bcrypt password hashes.
# It must never reach a remote, public or private.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- User uploads ------------------------------------------------------------
# Avatars, syllabus specifications and past paper PDFs uploaded by real users.
backend/uploads/
!backend/uploads/.gitkeep

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ---------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Deployment tooling ------------------------------------------------------
.vercel/
.render/

# --- Editor and agent config -------------------------------------------------
# Local run helpers with machine-specific absolute paths. See the README for
# portable commands.
.claude/
.vscode/
.idea/
*.swp

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
